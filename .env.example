# Proposed configuration only; .env loading is not implemented yet.
# Local development server
CLOUDNET_SERVER_HOST=127.0.0.1
CLOUDNET_SERVER_BIND_HOST=127.0.0.1
CLOUDNET_SERVER_PORT=5050

# TLS files: prepare before connecting to EC2.
CLOUDNET_TLS_CA_FILE=
CLOUDNET_TLS_CERT_FILE=
CLOUDNET_TLS_KEY_FILE=

# Set separate credentials locally. Never commit real values.
CLOUDNET_AGENT_TOKEN=
CLOUDNET_ADMIN_TOKEN=
CLOUDNET_AGENT_ID=

# Proposed timing defaults (seconds)
CLOUDNET_METRICS_INTERVAL_SECONDS=2
CLOUDNET_HEARTBEAT_INTERVAL_SECONDS=5
CLOUDNET_HEARTBEAT_TIMEOUT_SECONDS=15

# Server-side runtime database
CLOUDNET_DB_PATH=cloudnet.db
